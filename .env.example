# IBM watsonx / Granite generation configuration.
# Add WATSONX_API_KEY as a Replit Secret. The other values may also be
# stored in Replit Secrets or regular environment variables.
# If these are blank, retrieval still works in retrieval-only mode.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Optional: override the regional watsonx generation endpoint.
# WATSONX_API_URL=
# Optional: override IBM Cloud IAM only for a compatible private endpoint.
# WATSONX_IAM_TOKEN_URL=